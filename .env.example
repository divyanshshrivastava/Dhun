# ==============================================================================
# Dhun (धुन) - Zero-Cost Free-Tier Production & Development Environment Template
# ==============================================================================

# 1. PostgreSQL Database (Neon Free Tier)
# Use the pooled connection string (-pooler in hostname) to support serverless connection pooling
DATABASE_URL="postgresql://neondb_owner:npg_password@ep-cold-bread-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. Server Secret for HMAC Clip Token Signing & Anti-Cheat Daily Challenge Salt
# Must be at least 16 characters. Generate in terminal with: openssl rand -hex 32
DHUN_SERVER_SECRET="replace_with_a_secure_random_64_char_hex_secret_key_2026"

# 3. Upstash Redis (Free Tier - 500k commands/month)
# Applied only to /api/game/session and /api/game/guess via single-pipeline REST commands
UPSTASH_REDIS_REST_URL="https://your-upstash-redis-id.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_rest_token_here"

# 4. Cloudflare R2 Audio Clip Storage (Free Tier - 10 GB storage, $0 egress)
# S3-compatible object storage
R2_ACCOUNT_ID="your_cloudflare_account_id_here"
R2_ACCESS_KEY_ID="your_r2_access_key_id_here"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key_here"
R2_BUCKET_NAME="dhun-audio-clips"

# 5. Supabase Storage (Documented Fallback if Cloudflare Card Requirement is Skipped)
# Free Tier: 1 GB storage, 2 GB bandwidth
SUPABASE_STORAGE_URL="https://your-supabase-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"
SUPABASE_BUCKET_NAME="dhun-audio-clips"

# 6. Database Cleanup Cron Secret
# Protects GET /api/cron/cleanup for automated 30-day session retention pruning
CRON_SECRET="your_vercel_cron_secret_key_here"

# 7. Base Application URL
NEXT_PUBLIC_APP_URL="https://dhun.in"

# ==============================================================================
# Dhun (धुन) - Environment Configuration Template
# ==============================================================================

# Database Connection (Neon, Supabase, or Local PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dhun_db"

# Server-side Secret for HMAC Clip Signing & Game Sessions
# Generate with: openssl rand -hex 32
DHUN_SERVER_SECRET="replace-with-a-random-32-byte-hex-string-for-hmac"

# Redis Cache / Rate Limiting (Upstash Redis or Local Redis)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Cloudflare R2 Audio Storage (S3-compatible)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="dhun-audio-clips"
R2_PUBLIC_URL="https://clips.dhun.in"

# Base Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

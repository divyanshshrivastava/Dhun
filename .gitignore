# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/

# next.js
/.next/
/out/

# production
/build

# misc & os files
.DS_Store
Thumbs.db
*.pem

# debug & logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
*.conversation*

# env files
.env*
!.env.example

# audio masters and raw assets
/audio-masters/
/raw-audio/
/storage/
*.raw
*.mp3
*.wav
*.m4a
*.flac
*.aac
*.opus
*.ogg

# local documentation & private notes
IMPLEMENTATION_PLAN.md
PROGRESS_REPORT.md
DEPLOYMENT_CHECKLIST.md
*.local.md

# vercel & lighthouse
.vercel
*lighthouse*.json
*lighthouse*.html

# typescript
*.tsbuildinfo
next-env.d.ts

# embedded database (PGlite)
.pglite/
*.pglite/

# local conversation / scratch / agent logs
/.system_generated/
/.gemini/
/.agents/
/scratch/
/brain/
